# =============================================================================
# NewsIQ — Environment Variables
# Copy this file to .env.local for local development.
# Configure the same keys in Vercel > Project > Settings > Environment Variables.
# =============================================================================

# Supabase (required) — from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (public)
NEXT_PUBLIC_SITE_URL=https://newsiq.top

# AI providers (optional in Phase 1, required in Phase 4)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
