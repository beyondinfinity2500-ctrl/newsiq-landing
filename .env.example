# =============================================================================
# NewsIQ — Environment Variables
# Copy this file to .env.local for local development.
# Configure the same keys in Vercel > Project > Settings > Environment Variables.
# =============================================================================

# Supabase (required) — from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (public)
NEXT_PUBLIC_SITE_URL=https://newsiq.top

# AI providers (optional in Phase 1, required when AI features are enabled)
# The AI provider is OpenAI-compatible — supports OpenRouter, OpenAI, Together, vLLM, etc.
# Set AI_PROVIDER_BASE_URL and AI_PROVIDER_API_KEY to use OpenRouter or any OpenAI-compatible endpoint.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Provider (OpenAI-compatible) — recommended: OpenRouter
# Base URL for OpenRouter: https://openrouter.ai/api/v1
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_API_KEY=
# Model examples for OpenRouter:
#   openrouter/auto (auto-select best model)
#   openrouter/meta-llama/llama-3-8b-instruct
#   openrouter/anthropic/claude-3-haiku
AI_PROVIDER_MODEL=openrouter/auto

# Ingestion (Phase 5+) — set CRON_SECRET in your deployment environment.
# Vercel Cron will send it in the `x-cron-secret` header on each invocation.
# Generate a strong random value, e.g.: openssl rand -hex 32
CRON_SECRET=
